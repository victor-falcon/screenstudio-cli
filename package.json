{
  "name": "screenstudio-cli",
  "version": "0.1.0",
  "description": "CLI tool to control Screen Studio via Chrome DevTools Protocol",
  "type": "module",
  "bin": {
    "screenstudio": "./bin/screenstudio.js"
  },
  "files": [
    "bin/",
    "dist/",
    "skills/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShawnPana/screenstudio-cli.git"
  },
  "keywords": [
    "screen-studio",
    "screenstudio",
    "cli",
    "video-editing",
    "screen-recording",
    "cdp",
    "chrome-devtools-protocol",
    "automation"
  ],
  "author": "Shawn Pana",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
